FROM python:3.12-slim

WORKDIR /srv
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /srv/requirements.txt
RUN pip install --no-cache-dir -r /srv/requirements.txt
COPY backend /srv/backend
COPY risk-engine /srv/risk-engine
COPY workers /srv/workers
COPY shared /srv/shared
COPY database /srv/database
COPY docker/entrypoint-backend.sh /srv/entrypoint-backend.sh
RUN chmod +x /srv/entrypoint-backend.sh
ENV PYTHONPATH=/srv/backend:/srv/risk-engine:/srv/shared/python
EXPOSE 8000
CMD ["/srv/entrypoint-backend.sh"]
